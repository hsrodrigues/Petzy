rules_version = '2';

// ============================================================
//  Petzy - Regras do Cloud Storage
//  Arquivos ficam em clinicas/{clinicaId}/... e só membros daquela
//  clínica têm acesso (verificação cruzada com o Firestore).
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function membro(cid) {
      return request.auth != null && perfil().clinicaId == cid && perfil().ativo == true;
    }
    function admin(cid) {
      return membro(cid) && perfil().papel == 'admin';
    }

    // identidade visual (logo): só o admin envia; até 2 MB; somente imagens
    match /clinicas/{cid}/marca/{arquivo} {
      allow read: if membro(cid);
      allow create, update: if admin(cid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if admin(cid);
    }

    // demais arquivos da clínica (fotos, exames em PDF...)
    match /clinicas/{cid}/{outros=**} {
      allow read: if membro(cid);
      allow create, update: if membro(cid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if membro(cid);
    }
  }
}
