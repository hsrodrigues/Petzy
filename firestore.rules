rules_version = '2';

// ============================================================
//  Petzy - Regras de seguranca (SaaS multi-tenant + licenca)
//  /usuarios/{uid}        -> indice: a qual clinica o usuario pertence
//  /superadmins/{uid}     -> donos do SaaS (criado manualmente no console)
//  /clinicas/{cid}        -> tenant (dados + licenca)
//  /clinicas/{cid}/...    -> dados operacionais da clinica
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }

    function perfilPath() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function temPerfil() { return logado() && exists(perfilPath()); }
    function perfil() { return get(perfilPath()).data; }

    function superAdmin() {
      return logado() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function membro(cid) {
      return temPerfil() && perfil().clinicaId == cid && perfil().ativo == true;
    }
    function admin(cid) { return membro(cid) && perfil().papel == 'admin'; }

    function clinica(cid) { return get(/databases/$(database)/documents/clinicas/$(cid)).data; }

    // licenca valida = nao bloqueada e dentro da validade
    function licencaAtiva(cid) {
      let c = clinica(cid);
      return c.status in ['trial', 'ativo'] && c.validoAteMs > request.time.toMillis();
    }

    // campos de cobranca (e de agrupamento em rede) que so o superadmin altera: se o admin da
    // clinica pudesse editar redeId livremente, bastaria "adivinhar" o id de outra rede para
    // passar a ver os numeros agregados de um negocio que nao e o dele.
    function camposLicenca() {
      return ['plano', 'status', 'validoAteMs', 'trialAte', 'ownerUid', 'valorMensal', 'redeId'];
    }

    // modulo fiscal: admin e recepcao, ou quem recebeu o modulo como extra (e nao esta bloqueado)
    function podeFiscal(cid) {
      let p = perfil();
      let extras = p.get('modulosExtras', []);
      let bloqueados = p.get('modulosBloqueados', []);
      return membro(cid)
        && (p.get('papel', '') in ['admin', 'recepcao'] || (extras is list && extras.hasAny(['fiscal'])))
        && !(bloqueados is list && bloqueados.hasAny(['fiscal']));
    }

    // campos de nota fiscal que so o backend grava (retorno do provedor, protocolo, arquivos)
    function camposFiscaisServidor() {
      return ['protocolo', 'idProvedor', 'idIntegracao', 'situacaoProvedor', 'codigoVerificacao', 'dataAutorizacao',
        'pdfPath', 'xmlPath', 'enviadaEm', 'enviadaPor', 'tentativas', 'prestadorCnpj', 'semValorFiscal',
        'cancelamentoProtocolo', 'cancelamentoCodigo', 'cancelamentoMotivo', 'canceladaPor', 'canceladaEm',
        'ambiente', 'provedor', 'mensagem', 'protocoloAutorizacao'];
    }

    // ---------- donos do SaaS ----------
    match /superadmins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- planos (catalogo publico) ----------
    match /planos/{pid} {
      allow read: if true;
      allow write: if superAdmin();
    }

    // ---------- configuracao global do SaaS (PIX, links de pagamento) ----------
    match /sistema/{docId} {
      allow read: if true;
      allow write: if superAdmin();
    }

    // ---------- metadados internos do SaaS: so o superadmin le; so o backend grava ----------
    match /admin/{docId} {
      allow read: if superAdmin();
      allow write: if false;
    }

    // ---------- pedidos de assinatura/renovacao (funciona mesmo com licenca vencida) ----------
    match /solicitacoes/{id} {
      allow create: if admin(request.resource.data.clinicaId) && request.resource.data.status == 'pendente';
      allow read: if superAdmin() || (temPerfil() && resource.data.clinicaId == perfil().clinicaId);
      allow update, delete: if superAdmin();
    }

    // ---------- indice global de usuarios ----------
    match /usuarios/{uid} {
      allow read: if logado() && (
        request.auth.uid == uid || superAdmin() ||
        (temPerfil() && perfil().clinicaId == resource.data.clinicaId)
      );
      // cadastro do dono: cria o proprio doc como admin
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['clinicaId', 'papel', 'nome', 'email', 'ativo'])
        && clinica(request.resource.data.clinicaId).ownerUid == request.auth.uid;
      // convite de equipe feito pelo admin da clinica
      allow create: if admin(request.resource.data.clinicaId);
      allow update: if superAdmin() || admin(resource.data.clinicaId) || (
        request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clinicaId', 'papel', 'ativo'])
      );
      allow delete: if superAdmin() || admin(resource.data.clinicaId);
    }

    // ---------- clinica (tenant) ----------
    match /clinicas/{cid} {
      allow read: if membro(cid) || superAdmin();

      // nova clinica sempre nasce em trial de no maximo 15 dias
      allow create: if logado()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'trial'
        && request.resource.data.plano == 'trial'
        && request.resource.data.validoAteMs <= request.time.toMillis() + 15 * 86400000;

      allow update: if superAdmin() || (
        admin(cid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposLicenca())
      );
      allow delete: if superAdmin();

      // faturas da assinatura: clinica so le, superadmin gerencia
      match /faturas/{fid} {
        allow read: if membro(cid) || superAdmin();
        allow write: if superAdmin();
      }

      // equipe: so admin gerencia
      match /equipe/{uid} {
        allow read: if membro(cid) || superAdmin();
        allow write: if admin(cid);
      }

      // notas fiscais: rascunhos e notas registradas manualmente sao editaveis pelo app;
      // nota transmitida ao provedor (integracao == true) so muda pelo backend (Cloud Functions)
      match /fiscal/{nid} {
        allow read: if membro(cid) || superAdmin();
        allow create: if podeFiscal(cid) && licencaAtiva(cid)
          && !request.resource.data.keys().hasAny(camposFiscaisServidor())
          && (request.resource.data.get('integracao', false) != true || request.resource.data.get('status', '') == 'rascunho');
        allow update: if podeFiscal(cid) && licencaAtiva(cid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposFiscaisServidor())
          && (
            (resource.data.get('integracao', false) == true
              && resource.data.get('status', '') in ['rascunho', 'rejeitada']
              && request.resource.data.get('status', '') == resource.data.get('status', '')
              && request.resource.data.get('integracao', false) == true)
            || (resource.data.get('integracao', false) != true
              && (request.resource.data.get('integracao', false) != true || request.resource.data.get('status', '') == 'rascunho'))
          );
        allow delete: if podeFiscal(cid) && licencaAtiva(cid)
          && (resource.data.get('integracao', false) != true || resource.data.get('status', '') in ['rascunho', 'rejeitada']);
      }

      // auditoria: registro imutavel de quem criou/editou/excluiu cada registro. O app grava uma
      // linha a cada escrita (ver js/store.js); ninguem, nem o admin, pode alterar ou apagar depois -
      // senao um usuario mal-intencionado poderia cobrir o proprio rastro.
      match /auditoria/{docId} {
        allow read: if admin(cid) || superAdmin();
        allow create: if membro(cid) && licencaAtiva(cid) && request.resource.data.usuarioId == request.auth.uid;
        allow update, delete: if false;
      }

      // dados operacionais: leitura sempre; escrita so com licenca ativa.
      // IMPORTANTE: um match mais especifico (ex.: /auditoria/{docId} acima) NAO substitui este bloco
      // generico quando os dois combinam com o mesmo caminho - o Firestore combina as regras que
      // combinam com OR (basta uma permitir). Por isso toda colecao com regra propria tem que
      // aparecer aqui tambem, senao esta regra generica reabre exatamente o que a especifica fechou.
      match /{colecao}/{docId} {
        allow read: if membro(cid) || superAdmin();
        allow create, update: if membro(cid) && licencaAtiva(cid)
          && !(colecao in ['faturas', 'equipe', 'fiscal', 'auditoria']);
        allow delete: if membro(cid) && licencaAtiva(cid)
          && !(colecao in ['faturas', 'equipe', 'fiscal', 'auditoria'])
          && perfil().papel in ['admin', 'veterinario'];
      }
    }
  }
}
