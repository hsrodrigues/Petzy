rules_version = '2';

// ============================================================
//  VetFlow - Regras de seguranca (multi-tenant por clinica)
//  Cada usuario tem um doc em /usuarios/{uid} apontando para
//  a clinica a qual pertence. Todo dado operacional vive em
//  /clinicas/{clinicaId}/... e so e acessivel por membros ativos.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // membro ativo da clinica informada
    function membro(cid) {
      return temPerfil() && perfil().clinicaId == cid && perfil().ativo == true;
    }

    function admin(cid) {
      return membro(cid) && perfil().papel == 'admin';
    }

    // ---------- indice global de usuarios ----------
    match /usuarios/{uid} {
      // o proprio usuario ou um colega da mesma clinica pode ler
      allow read: if logado() && (
        request.auth.uid == uid ||
        (temPerfil() && perfil().clinicaId == resource.data.clinicaId)
      );

      // cadastro inicial: o usuario cria o proprio doc
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['clinicaId','papel','nome','email','ativo']);

      // convite de equipe: admin da clinica cria/edita membros
      allow create: if logado()
        && admin(request.resource.data.clinicaId);

      allow update: if logado() && (
        admin(resource.data.clinicaId) ||
        // o proprio usuario so pode mudar dados de perfil, nunca papel/clinica/ativo
        (request.auth.uid == uid
          && request.resource.data.clinicaId == resource.data.clinicaId
          && request.resource.data.papel == resource.data.papel
          && request.resource.data.ativo == resource.data.ativo)
      );

      allow delete: if logado() && admin(resource.data.clinicaId);
    }

    // ---------- clinica (tenant) ----------
    match /clinicas/{cid} {
      allow read: if membro(cid);
      allow create: if logado() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if admin(cid);
      allow delete: if false;

      // ---------- todos os dados operacionais da clinica ----------
      // clientes, pets, agendamentos, atendimentos, vacinas,
      // produtos, vendas, financeiro, movimentacoes...
      match /{documento=**} {
        allow read: if membro(cid);
        allow create, update: if membro(cid);
        allow delete: if membro(cid) && perfil().papel in ['admin', 'veterinario'];
      }
    }
  }
}
